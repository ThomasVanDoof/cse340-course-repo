
<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <% if (project) { %>
            <p><strong>Description:</strong> <%= project.description %></p>
            <p><strong>Date:</strong> <%= project.date %></p>
            <p><strong>Location:</strong> <%= project.location %></p>
            <p><strong>Organization:</strong> <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a></p>
            <% if (categories && categories.length > 0) { %>
                <p><strong>Categories:</strong>
                    <% categories.forEach((category, index) => { %>
                        <% if (index > 0) { %> | <% } %>
                        <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                    <% }); %>
                </p>
            <% } %>
            <% if (user && user.role_name === 'admin') { %>
                <p>
                    <a href="/edit-project/<%= project.project_id %>">Edit Project</a> | 
                    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                </p>
            <% } %>
        <% } else { %>
            <p>Project not found.</p>
        <% } %>
    </main>
<%- include('partials/footer') %>
