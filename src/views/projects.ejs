
<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Upcoming Projects:</p>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong> - <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>