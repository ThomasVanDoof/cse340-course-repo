<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Categories</h2>
    <ul>
        <% categories.forEach(category => { %>
            <li><a href="/categories/<%= category.name.toLowerCase().replace(' ', '-') %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>